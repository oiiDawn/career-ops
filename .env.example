# Local Career Ops environment. Copy to .env.
# Workflow model: one OpenAI-compatible chat endpoint used inside the LangGraph nodes.
CAREER_OPS_MODEL=your_model_name
CAREER_OPS_LLM_BASE_URL=https://your-endpoint.example/v1
CAREER_OPS_LLM_API_KEY=your_model_api_key
# CAREER_OPS_REASONING_EFFORT=high
# Score research and the Node search provider use Tavily.
TAVILY_API_KEY=your_tavily_api_key
# Optional fallback when the primary key reaches its plan or pay-as-you-go limit.
# TAVILY_BACKUP_API_KEY=your_backup_tavily_api_key
# Optional self-hosted Langfuse tracing; all three must be set (never point at a shared host).
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Reactive Resume is an existing local service configured in inputs/profile.yml.
# REACTIVE_RESUME_API_KEY=your_local_api_key

# Optional explicit input directory; its sibling rules/ contains frozen policies.
# CAREER_OPS_INPUT_ROOT=/absolute/path/to/inputs
# CAREER_OPS_PORTALS=/absolute/path/to/inputs/portals.yml
# CAREER_OPS_PROFILE=/absolute/path/to/inputs/profile.yml

# Optional provider tokens used only by configured collection sources.
# APIFY_TOKEN=your_provider_token

# Deterministic notification delivery remains disabled unless explicitly authorized.
# CAREER_OPS_NOTIFICATIONS_ENABLED=0
